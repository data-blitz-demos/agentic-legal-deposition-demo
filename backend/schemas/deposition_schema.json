{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/deposition_schema.json",
  "title": "DepositionSchema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "file_name",
    "witness_name",
    "witness_role",
    "summary",
    "claims"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "file_name": {
      "type": "string",
      "minLength": 1
    },
    "witness_name": {
      "type": "string",
      "minLength": 1
    },
    "witness_role": {
      "type": "string",
      "minLength": 1
    },
    "deposition_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "statement",
          "confidence",
          "source_quote"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
